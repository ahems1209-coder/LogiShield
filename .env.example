# LogiShield AI - Environment Variables Template
# Copy this file to .env and configure appropriate values for local or production deployment.

# Node Server Port (Default: 3000)
PORT=3000
NODE_ENV=production

# Application URL
APP_URL=http://localhost:3000

# Google Gemini AI API Key (Server-Side Only)
# Get a key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Database Connection URL (Optional - default is high-performance in-memory state store)
DATABASE_URL=postgresql://postgres.hethmntfeibfmgvrbdla:fMlVBuuhRdipyVJd@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres

# Authentication & Session Security
JWT_SECRET=your-production-jwt-secret-key-change-in-production

# IoT Telemetry Integrations (Optional)
THINGSPEAK_CHANNEL_ID=
THINGSPEAK_WRITE_API_KEY=
THINGSPEAK_READ_API_KEY=
